{
  "expo": {
    "name": "Abhivyakti",
    "slug": "abhivyakti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "abhivyakti",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abhivyakti.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Abhivyakti uses the camera to recognize Indian Sign Language signs you show.",
        "NSPhotoLibraryUsageDescription": "Abhivyakti needs access to your photos so you can upload a sign image for recognition."
      }
    },
    "android": {
      "package": "com.abhivyakti.app",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F45B16",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Abhivyakti to access photos to recognize signs."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Abhivyakti to use the camera to recognize signs."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "react-native-fast-tflite",
      "expo-asset"
    ]
  }
}