{
  "manifest_version": 3,
  "name": "Abhivyakti",
  "version": "0.1.0",
  "key": "",
  "description": "Abhivyakta reads Indian Sign Language fingerspelling (A-Z, 0-9) from videos on YouTube, Google Meet and other sites and shows editable captions beside the video. Runs fully on your device.",
  "permissions": [
    "storage",
    "identity"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Abhivyakti"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "content/caption-state.js",
        "content/content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "engine/engine.html",
        "icons/mark.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggle-isl": {
      "suggested_key": {
        "default": "Alt+Shift+I"
      },
      "description": "Turn Abhivyakta on/off"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "http://localhost:8000/*",
    "https://abhivyakti-backend-486350221693.asia-south1.run.app/*"
  ]
}